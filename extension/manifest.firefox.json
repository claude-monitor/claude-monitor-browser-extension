{
  "manifest_version": 3,
  "name": "Claude Usage Tracker: Session & Weekly Limits",
  "short_name": "Claude Usage",
  "version": "1.16.1",
  "description": "Live Claude usage in your toolbar: session and weekly limits, per-model caps, credits, reset times, and alerts at 80% and 95%.",
  "author": "Digital Advanced Solutions",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-usage-monitor@digitaladvanced.solutions",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["notifications", "scripting"],
  "optional_host_permissions": ["https://claude.ai/*"],
  "host_permissions": [
    "https://claude.ai/api/organizations",
    "https://claude.ai/api/organizations/*/usage",
    "https://claude.ai/api/organizations/*/prepaid/credits",
    "https://claude.ai/api/organizations/*/overage_spend_limit",
    "https://claude.ai/v1/code/routines/run-budget"
  ],
  "homepage_url": "https://claude-monitor.com/",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Usage Monitor",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
